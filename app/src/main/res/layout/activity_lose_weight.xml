        <ImageButton android:id="@+id/btnSave" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_brown_button" android:contentDescription="Save" android:src="@drawable/ic_save" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/btnBack" app:tint="@android:color/black" />
        <LinearLayout android:id="@+id/loseWeightExerciseList" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:orientation="vertical" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/btnBack">
            <LinearLayout android:id="@+id/cardLoseWeightExercise1" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_exercise_detail_card" android:orientation="vertical" android:padding="14dp"><TextView android:id="@+id/tvLoseWeightExercise1Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1  JUMPING JACKS" android:textColor="#F3A047" android:textSize="18sp" android:textStyle="bold" /><ImageView android:id="@+id/imgLoseWeightExercise1" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="12dp" android:contentDescription="Jumping jacks composite instruction" android:scaleType="centerCrop" android:src="@drawable/placeholder_exercise" /><TextView android:id="@+id/tvLoseWeightExercise1Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="START - JUMP OPEN - JUMP BACK" android:textColor="#E0E0E0" android:textSize="13sp" android:textStyle="bold" /></LinearLayout>
            <LinearLayout android:id="@+id/cardLoseWeightExercise2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_exercise_detail_card" android:orientation="vertical" android:padding="14dp"><TextView android:id="@+id/tvLoseWeightExercise2Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2  HIGH KNEES" android:textColor="#F3A047" android:textSize="18sp" android:textStyle="bold" /><ImageView android:id="@+id/imgLoseWeightExercise2" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="12dp" android:contentDescription="High knees composite instruction" android:scaleType="centerCrop" android:src="@drawable/placeholder_exercise" /><TextView android:id="@+id/tvLoseWeightExercise2Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="START - KNEE UP - SWITCH LEGS" android:textColor="#E0E0E0" android:textSize="13sp" android:textStyle="bold" /></LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/theme2">

    <View
        android:id="@+id/darkOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <TextView
        android:id="@+id/titleWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome\nback"
        android:textColor="#FFFFFF"
        android:textSize="42sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="70dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/subtitleLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Log in and\nkeep on moving"
        android:textColor="#DDFFFFFF"
        android:textSize="27sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/titleWelcome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/loginPanel"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="#66222222"
        app:layout_constraintTop_toBottomOf="@id/subtitleLogin"
        android:layout_marginTop="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/inputUsername"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:hint="username"
            android:textColor="#FFFFFF"
            android:hintTextColor="#DDFFFFFF"
            android:background="#77777777"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <EditText
            android:id="@+id/inputPassword"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:hint="password"
            android:textColor="#FFFFFF"
            android:hintTextColor="#DDFFFFFF"
            android:background="#77777777"
            android:inputType="textPassword"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/forgotPassword"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="end"
            android:text="Forgot password?"
            android:textColor="#3FA9F5"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:text="LOG IN"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="@drawable/button_gradient" />

        <TextView
            android:id="@+id/noAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Don’t have an account?"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:text="REGISTER"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#FF5722" />

    </LinearLayout>

    <TextView
        android:id="@+id/bottomQuote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Small steps. Real progress"
        android:textColor="#DDFFFFFF"
        android:textSize="20sp"
        android:textStyle="italic"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="70dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>